# Production env template for Gonaj. Copy to .env.prod on the VPS only.
# Never commit .env.prod. See docs/deployment.md.
DJANGO_SECRET_KEY=change-me-generate-with-secrets-token
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=gonaj.in
POSTGRES_DB=gonaj
POSTGRES_USER=gonaj
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
TRANSPORT_TRUSTED_PROXY=caddy
# Abuse budgets: per-IP, app-enforced (source of truth; no Caddy/Cloudflare rate limits).
JOURNEY_THROTTLE_MINUTE=60/min
JOURNEY_THROTTLE_DAY=1500/day
TRANSCRIBE_THROTTLE_MINUTE=20/min
TRANSCRIBE_THROTTLE_DAY=300/day
FEEDBACK_THROTTLE_MINUTE=20/min
FEEDBACK_THROTTLE_DAY=100/day
# Request size caps.
JOURNEY_MAX_QUESTION_CHARS=500
JOURNEY_MAX_HISTORY_TURNS=10
JOURNEY_MAX_TURN_CHARS=500
JOURNEY_MAX_CONTEXT_BYTES=8192
MODEL_API_KEY=
JOURNEY_MODEL=muse-spark-1.3
JOURNEY_MODEL_PROVIDER=meta
TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_TIMEOUT_SECONDS=20
