# Production env template for Gonaj. Copy to .env.prod on the VPS only.
# Never commit .env.prod. See docs/deployment.md.
DJANGO_SECRET_KEY=change-me-generate-with-secrets-token
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=gonaj.in
POSTGRES_DB=gonaj
POSTGRES_USER=gonaj
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
TRANSPORT_TRUSTED_PROXY=caddy
MODEL_API_KEY=
JOURNEY_MODEL=muse-spark-1.3
JOURNEY_MODEL_PROVIDER=meta
TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_TIMEOUT_SECONDS=20
